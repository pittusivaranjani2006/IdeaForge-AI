# ─────────────────────────────────────────────────────────────
# IdeaForge AI — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Database
# Development default shown below. Production requires an explicit DATABASE_URL.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD_HERE@localhost:5432/ideaforge

# JWT
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider (OpenAI-compatible)
# Set OPENAI_API_KEY to your key. Provider can be switched by
# changing AI_BASE_URL (e.g. for local Ollama or other providers).
# AI Provider (Gemini)
OPENAI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_BASE_URL=https://api.openai.com/v1   # optional override

# CORS — comma-separated origins allowed to call the API
# Development may use localhost and 127.0.0.1.
# Production requires explicit HTTPS origins without credentials, paths, queries, or fragments.
# In development: http://localhost:5500,http://127.0.0.1:5500
# In production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Rate limiting
RATE_LIMIT_PER_MINUTE=30
AI_RATE_LIMIT_PER_MINUTE=10

# App
# Supported APP_ENV values: development, test, staging, production. Aliases: dev, prod.
# Production requires APP_ENV=production with explicit SECRET_KEY, DATABASE_URL,
# and ALLOWED_ORIGINS. Local development can keep the defaults below.
APP_ENV=development
APP_VERSION=1.0.0
